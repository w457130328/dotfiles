set $mod Mod4

exec --no-startup-id /home/jiangtao/.local/bin/auto-primary
# 壁纸：随机轮播（每 10 分钟换一张），脚本在 bin/wallpaper-rotate
exec --no-startup-id /home/jiangtao/bin/wallpaper-rotate
exec --no-startup-id fcitx5 -d
exec --no-startup-id snixembed
exec --no-startup-id nm-applet
exec --no-startup-id Snipaste
exec --no-startup-id /home/jiangtao/.local/bin/v2rayn
# exec --no-startup-id /home/jiangtao/.local/bin/vpn-up
exec --no-startup-id xset s off -dpms

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:feathericon 9, Poppins Regular 9

workspace_layout tabbed
                        #border  background text    indicator child_border
client.focused          #e46c6d #dbd9da #3b4d4f #b899a8 #819fc1
client.focused_inactive #dbd9da #dbd9da #3b4d4f #dbd9da #dbd9da
client.unfocused        #dbd9da #dbd9da #3b4d4f #dbd9da #dbd9da
client.urgent           #e46c6d #d8af60 #3b4d4f #d8af60 #d8af60
client.placeholder      #dbd9da #dbd9da #3b4d4f #dbd9da #dbd9da
client.background       #dbd9da

floating_modifier $mod

# kill focused window
bindsym $mod+q exec "_i3-graceful-kill"

# open terminal
bindsym $mod+Return exec --no-startup-id /home/jiangtao/bin/urxvt-leaf
bindsym $mod+apostrophe exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -cd "$(/home/jiangtao/bin/focused-cwd)"
bindsym $mod+u split h; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf
bindsym $mod+y split h; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -cd "$(/home/jiangtao/bin/focused-cwd)"
bindsym $mod+i split v; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf
bindsym $mod+o split v; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -cd "$(/home/jiangtao/bin/focused-cwd)"
# with VIM
bindsym $mod+Control+Return exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -e zsh-vim
bindsym $mod+Control+apostrophe exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -cd "$(/home/jiangtao/bin/focused-cwd)" -e zsh-vim
bindsym $mod+Control+u split h; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -e zsh-vim
bindsym $mod+Control+y split h; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -cd "$(/home/jiangtao/bin/focused-cwd)" -e zsh-vim
bindsym $mod+Control+i split v; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -e zsh-vim
bindsym $mod+Control+o split v; exec --no-startup-id /home/jiangtao/bin/urxvt-leaf -cd "$(/home/jiangtao/bin/focused-cwd)" -e zsh-vim

# start rofi (a program launcher)
bindsym $mod+g exec rofi -show run
bindsym $mod+Shift+g exec rofimoji

# start programs
bindsym $mod+Mod1+1 exec chromium
bindsym $mod+Mod1+2 exec firefox
bindsym $mod+Mod1+3 exec idea
bindsym $mod+Mod1+5 exec spotify
bindsym $mod+Mod1+6 exec rofi -show calc
bindsym $mod+Mod1+9 exec pavucontrol

# move mouse out of the way
bindsym $mod+Control+m exec xdotool mousemove $(xdpyinfo | grep dimensions | awk '{print $2}'| sed 's/x/ /')

# Pulse Audio controls
bindsym $mod+Mod1+0 exec --no-startup-id pactl set-sink-mute 0 toggle
bindsym $mod+Mod1+minus exec --no-startup-id pactl set-sink-volume 0 -5%
bindsym $mod+Mod1+Shift+equal exec --no-startup-id pactl set-sink-volume 0 +5%
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume 0 +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume 0 -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute 0 toggle

# Sreen brightness controls
bindsym XF86MonBrightnessDown exec --no-startup-id sudo -n backlight-down
bindsym XF86MonBrightnessUp exec --no-startup-id sudo -n backlight-up

# screenshot
bindsym $mod+Home exec "sleep 0.1; scrot -e 'mv $f /tmp/'"
bindsym $mod+Shift+Home exec "sleep 0.1; scrot -s -e 'mv $f /tmp/'"
bindsym $mod+Mod1+Home exec "_i3-screencast-active-window $(xdotool getactivewindow)"

# magnifier
bindsym $mod+x exec "kmag"

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# split in horizontal orientation
bindsym $mod+z split h

# split in vertical orientation
bindsym $mod+v split v

# split and merge windows
bindsym $mod+Control+Mod1+h split h; focus left; move right
bindsym $mod+Control+Mod1+l split h; focus right; move left
bindsym $mod+Control+Mod1+j focus left; split v; focus right; move left
bindsym $mod+Control+Mod1+k split v; focus right; move left

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+s sticky toggle

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+d focus child

# switch to workspace
bindsym $mod+Control+h workspace prev
bindsym $mod+Control+l workspace next
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Control+n exec --no-startup-id new-workspace

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10
bindsym $mod+Control+Shift+h exec "i3-msg move container to workspace prev && i3-msg workspace prev"
bindsym $mod+Control+Shift+l exec "i3-msg move container to workspace next && i3-msg workspace next"

# switch to monitor
bindsym $mod+Mod1+h move workspace to output left
bindsym $mod+Mod1+l move workspace to output right
bindsym $mod+Mod1+k move workspace to output up
bindsym $mod+Mod1+j move workspace to output down

# move workspace to monitor
bindsym $mod+Mod1+Shift+h move workspace to output left
bindsym $mod+Mod1+Shift+l move workspace to output right
bindsym $mod+Mod1+Shift+k move workspace to output up
bindsym $mod+Mod1+Shift+j move workspace to output down

# scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# keyboard layout
bindsym $mod+grave exec "_switch-keyboard"
bindsym $mod+Shift+grave exec "_switch-keyboard-default"
bindsym $mod+Cyrillic_io exec "_switch-keyboard"
bindsym $mod+Shift+Cyrillic_io exec "_switch-keyboard-default"

# 重新检测屏幕分辨率/物理尺寸并应用缩放（切 4K/1080p 之后按一下即可）
# 脚本自己会调 i3-msg reload 让标题栏和 i3bar 用上新字号
bindsym $mod+Mod1+d exec --no-startup-id auto-dpi

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+q exec "i3-msg exit"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # back to normal
        bindsym Escape mode "default"
        bindsym Return mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
    position top
    workspace_min_width 24
    padding 2px 8px 2px 8px
    colors {
        background #f9faf4
        statusline #3b4d4f
        separator #f9faf4

        focused_workspace  #f9faf4 #68c7c1 #3b4d4f
        active_workspace   #f9faf4 #f9faf4 #3b4d4f
        inactive_workspace #f9faf4 #f9faf4 #3b4d4f
        urgent_workspace   #f9faf4 #e46c6d #3b4d4f
        binding_mode       #f9faf4 #d8af60 #3b4d4f
    }
        status_command i3status --config ~/.config/i3status.conf | ~/.config/i3status/bluetooth.py
        tray_output primary
}

new_window pixel 8
focus_follows_mouse no

hide_edge_borders smart
gaps inner 12
smart_gaps on

for_window [class=".*"] border pixel 8
for_window [class=".*"] title_format "%title"

set $mode_system System (l) lock, (e) logout, (x) suspend, (s) suspend & lock, (r) reboot, (h) shutdown
mode "$mode_system" {
    bindsym l exec --no-startup-id xexit lock, mode "default"
    bindsym e exec --no-startup-id xexit logout, mode "default"
    bindsym x exec --no-startup-id xexit suspend, mode "default"
    bindsym s exec --no-startup-id xexit suspend-lock, mode "default"
    bindsym r exec --no-startup-id xexit reboot, mode "default"
    bindsym h exec --no-startup-id xexit shutdown, mode "default"

    # back to normal
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+Shift+Escape mode "default"
}

bindsym $mod+Shift+Escape mode "$mode_system"

# rules
for_window [class="pinentry"] floating enable
for_window [class="kruler"] floating enable
for_window [class="Animate"] floating enable
for_window [class="fullscreen"] fullscreen enable
for_window [class="kmag"] floating enable resize set 640 640
